# Copia este archivo como .env y llena los valores. El .env no se sube al repositorio.

# Base de datos Oracle
DB_URL=jdbc:oracle:thin:@host:1521/servicio
DB_USER=
DB_PASSWORD=

# Debe ser la misma clave que usa la API de servicios
JWT_SECRET=
JWT_EXPIRATION=900000

# Correo para la recuperación de contraseña (contraseña de aplicación de Gmail)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Orígenes permitidos por CORS, separados por coma
CORS_ALLOWED_ORIGINS=https://psykeweb.vercel.app,http://localhost:5500,http://127.0.0.1:5500
PORT=8081
